# ============================================
# 官网客服接入现有 FastGPT 的服务器环境模板
# 使用方式：
# 1. 复制成 deploy/env/guanwang.server.env
# 2. 填好下面的真实值
# 3. 运行：
#    pwsh -File .\scripts\start-guanwang.ps1 -Port 4180 -EnvFile .\deploy\env\guanwang.server.env
# ============================================

# 现有 FastGPT 应用接口
FASTGPT_APP_API_URL=http://127.0.0.1:3100/api/v1/chat/completions
FASTGPT_APP_API_KEY=__FILL_AI1_FASTGPT_APP_API_KEY__

# 推荐先用 fastgpt_prefer
# fastgpt_prefer = 优先走 FastGPT，失败再走直连模型兜底
# fastgpt = 只走 FastGPT
# direct = 不推荐，本项目会偏离真实知识库效果
CHAT_BACKEND=fastgpt_prefer

# 直连模型兜底所需
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
CHAT_API_KEY=__FILL_MODEL_API_KEY__

# 可选：DeepSeek 文本兜底
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# 官网站点允许来源
ALLOWED_ORIGINS=http://kefuceshi2.5593102.top,http://43.99.50.75

# FastGPT / MinIO 对外地址
# 如果你现有 FastGPT 图片上传也要正常走，请填现有对象存储公网地址
FE_DOMAIN=http://kefuceshi2.5593102.top:3100
STORAGE_EXTERNAL_ENDPOINT=http://kefuceshi2.5593102.top:9100

# 如果 upload_minio_public.py 需要直接签名上传，则要填现有 MinIO 密钥
MINIO_ROOT_USER=__FILL_IF_NEEDED__
MINIO_ROOT_PASSWORD=__FILL_IF_NEEDED__
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BUCKET=fastgpt-public
STORAGE_PRIVATE_BUCKET=fastgpt-private

# 如果当前服务器上已有 FastGPT Mongo 容器名不是 fastgpt-mongo，可填真实名字
FASTGPT_MONGO_CONTAINER=ai1-fastgpt-mongo

# 调试与行为开关
DEMO_CHAT_MODE=live_only
DEMO_GUIDED_ANSWER=off
LOG_CONSOLE_LEVEL=info
