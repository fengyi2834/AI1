# ============================================
# 服务器新增一套 AI1 FastGPT 的环境模板
# 不会和现有 mvp-nginx-server666666 / mvp-cs-lab-server666666 冲突
# 使用方式：
# 1. 复制成 deploy/env/fastgpt.server.ai1.env
# 2. 填好真实值
# 3. 运行：
#    pwsh -File .\scripts\start-local.ps1 `
#      -ComposeFile .\infra\fastgpt\docker-compose.local.yml `
#      -EnvFile .\deploy\env\fastgpt.server.ai1.env
# 4. 如果要启用独立容器名，再叠加 override：
#    docker compose --env-file .\deploy\env\fastgpt.server.ai1.env `
#      -f .\infra\fastgpt\docker-compose.local.yml `
#      -f .\infra\fastgpt\docker-compose.server.ai1.override.yml up -d
# ============================================

FASTGPT_IMAGE_TAG=v4.14.10.1
FASTGPT_CODE_SANDBOX_IMAGE_TAG=v4.14.10
FASTGPT_MCP_SERVER_IMAGE_TAG=v4.14.3
FASTGPT_PLUGIN_IMAGE_TAG=v0.5.6
AIPROXY_IMAGE_TAG=v0.3.5
MONGO_IMAGE_TAG=5.0.32

# 这套新 FastGPT 使用的端口
FASTGPT_PORT=3100
FASTGPT_MCP_PORT=3105
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# 对外访问地址
FE_DOMAIN=http://kefuceshi2.5593102.top:3100
STORAGE_EXTERNAL_ENDPOINT=http://kefuceshi2.5593102.top:9100

# FastGPT 管理密钥
DEFAULT_ROOT_PSW=__FILL_STRONG_PASSWORD__
ROOT_KEY=__FILL_ROOT_KEY__
TOKEN_KEY=__FILL_TOKEN_KEY__
FILE_TOKEN_KEY=__FILL_FILE_TOKEN_KEY__
AES256_SECRET_KEY=__FILL_AES256_SECRET_KEY__
PLUGIN_TOKEN=__FILL_PLUGIN_TOKEN__
CODE_SANDBOX_TOKEN=__FILL_CODE_SANDBOX_TOKEN__
VOLUME_MANAGER_TOKEN=__FILL_VOLUME_MANAGER_TOKEN__
AIPROXY_API_TOKEN=__FILL_AIPROXY_API_TOKEN__

# 数据库账号
PG_USER=ai1_pg_user
PG_PASSWORD=__FILL_PG_PASSWORD__
PG_DB=postgres

MONGO_USER=ai1_mongo_user
MONGO_PASSWORD=__FILL_MONGO_PASSWORD__

REDIS_PASSWORD=__FILL_REDIS_PASSWORD__

# MinIO
MINIO_ROOT_USER=__FILL_MINIO_USER__
MINIO_ROOT_PASSWORD=__FILL_MINIO_PASSWORD__
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BUCKET=fastgpt-public
STORAGE_PRIVATE_BUCKET=fastgpt-private

# 模型平台
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
CHAT_API_KEY=__FILL_MODEL_API_KEY__

# 官网站点允许来源
ALLOWED_ORIGINS=http://kefuceshi2.5593102.top,http://43.99.50.75
LOG_CONSOLE_LEVEL=info
