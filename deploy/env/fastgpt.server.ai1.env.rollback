# 回滚用 — 旧版本镜像标签。如果 v4.14.22 有问题，把 fastgpt.server.ai1.env 里的版本号改回这些值
FASTGPT_IMAGE_TAG=v4.14.10.1
FASTGPT_CODE_SANDBOX_IMAGE_TAG=v4.14.10
FASTGPT_MCP_SERVER_IMAGE_TAG=v4.14.3
FASTGPT_PLUGIN_IMAGE_TAG=v0.5.6
AIPROXY_IMAGE_TAG=v0.3.5
MONGO_IMAGE_TAG=5.0.32

# 回滚步骤（在服务器 infra/fastgpt/ 目录执行）：
# 1. cp ../../deploy/env/fastgpt.server.ai1.env.rollback ../../deploy/env/fastgpt.server.ai1.env
#    或者手动把上面 4 个 FASTGPT 开头的版本号改回旧值
# 2. docker compose -f docker-compose.local.yml -f docker-compose.server.ai1.override.yml --env-file ../../deploy/env/fastgpt.server.ai1.env down
# 3. docker compose -f docker-compose.local.yml -f docker-compose.server.ai1.override.yml --env-file ../../deploy/env/fastgpt.server.ai1.env up -d
# 4. docker compose -f docker-compose.local.yml -f docker-compose.server.ai1.override.yml logs -f --tail=50
